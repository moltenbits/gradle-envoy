.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA
.idea/
*.iml

# Gradle wrapper auto-generated when an example is opened standalone in an IDE.
# Examples are meant to be run from the repo root: ./gradlew -p examples/<name> ...
examples/*/gradlew
examples/*/gradlew.bat
examples/*/gradle/
