#!/bin/sh
# A fake HashiCorp Vault CLI for running the vault-app example without a real server.
#
# It ignores the arguments and prints a fixed value, mimicking `vault kv get -field=<f> <path>`.
# Wire it in by setting ENVOY_EXAMPLE_VAULT to this file's path (see examples/README.md);
# by default the example uses the real `vault` on your PATH.
printf 'example-vault-secret'
