# A plain value: loaded from .env and injected into every JVM Gradle forks.
ENVOY_EXAMPLE_GREETING=Hello from .env

# A 1Password reference: resolved at run time via the `op` CLI.
# Point it at a real item in your vault and run with the real `op` to see it resolved,
# or run with the bundled fake CLI (see examples/README.md) for a hermetic demo.
ENVOY_EXAMPLE_TOKEN="op://Example Vault/Example Item/credential"
