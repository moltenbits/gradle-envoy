#!/bin/sh
# A fake SecretSpec CLI for running the secretspec-app example without secretspec installed.
#
# It ignores the arguments and prints a fixed value, mimicking `secretspec get <NAME>`.
# Wire it in by setting ENVOY_EXAMPLE_SECRETSPEC to this file's path (see examples/README.md);
# by default the example uses the real `secretspec` on your PATH.
printf 'example-secretspec-secret'
